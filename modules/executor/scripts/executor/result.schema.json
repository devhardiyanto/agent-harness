{
  "type": "object",
  "required": ["task_id", "status", "files_changed", "commands_run", "ac_claims", "deviations", "open_questions"],
  "properties": {
    "task_id": { "type": "string" },
    "status": { "type": "string", "enum": ["DONE", "PARTIAL", "BLOCKED"] },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd", "exit"],
        "properties": { "cmd": { "type": "string" }, "exit": { "type": "integer" } }
      }
    },
    "ac_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "evidence"],
        "properties": { "id": { "type": "string" }, "evidence": { "type": "string" } }
      }
    },
    "deviations": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
