{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "medium",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "outputStyle": "harness",
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/statusline.mjs",
    "padding": 0,
    "refreshInterval": 5
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_ecdsa*)",
      "Read(./**/credentials)",
      "Read(./**/credentials.json)",
      "Read(./**/.npmrc)",
      "Read(./**/.netrc)"
    ],
    "allow": [
      "Bash(node .claude/hooks/harness.mjs *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
