{
  "harness_version": "1.13.0",
  "project": "",
  "root_branch": "main",
  "layout": "multi-repo",
  "services_dir": "source-code",
  "services": [],
  "protected_branches": [
    "main",
    "master",
    "develop",
    "production",
    "staging",
    "release/*"
  ],
  "schema_paths": [
    "**/migrations/**",
    "**/migration/**",
    "**/*.sql",
    "**/schema.prisma"
  ],
  "gate": {
    "test_command": null,
    "test_required": false,
    "test_timeout_sec": 300,
    "require_checks": false
  },
  "context": {
    "window_tokens": 1000000,
    "warn_tokens": 400000
  },
  "knowledge": {
    "summary_max_lines": 80,
    "patterns_max_lines": 150,
    "stale_warn_commits": 15
  },
  "baseline": {},
  "quick": {
    "max_files": 5
  },
  "amend": {
    "max": 3
  },
  "checks": {},
  "ship": {
    "base": {},
    "merge_method": "merge",
    "ticket_ttl_min": 30,
    "merge_on_request": true,
    "intent_ttl_min": 240
  },
  "store": {
    "backend": "local"
  },
  "align": {
    "required": true,
    "max_rounds": 3,
    "exempt_types": [
      "onboard",
      "analysis"
    ],
    "accept_contradictions": true,
    "decision_table": true,
    "block_plan_before_aligned": true
  },
  "stop_gate": {
    "enabled": true,
    "max_blocks": 2,
    "recent_hours": 12
  },
  "handoff": {
    "max_chars": 6000
  },
  "update": {
    "autoPush": false
  },
  "plane": {
    "enabled": false,
    "base_url": "https://api.plane.so",
    "workspace": null,
    "project_id": null,
    "token_env": "PLANE_API_KEY",
    "marker": "[harness]",
    "push_content": true,
    "pull_comments": true,
    "mention_user_id": null,
    "pull_min_interval_s": 60,
    "states": {
      "draft": "Backlog",
      "approved": "Todo",
      "in-progress": "In Progress",
      "in-review": "Review",
      "done": "Done",
      "merged": "Done"
    }
  },
  "intent": {
    "enabled": true,
    "max_chars": 120
  },
  "recap": {
    "enabled": true,
    "on_stop": true,
    "max_rows": 12
  },
  "memory": {
    "enabled": true,
    "max_chars": 2200,
    "user_enabled": true,
    "user_max_chars": 1375,
    "write_approval": false,
    "learn_from_summary": true,
    "learn_max": 3,
    "ref_max_chars": 3000
  },
  "playbooks": {
    "enabled": true,
    "max_chars": 6000,
    "index_max": 20
  },
  "pilot": {
    "enabled": true,
    "days": 14,
    "max_misfires": 0,
    "min_ships": 1
  }
}
