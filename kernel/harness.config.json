{
  "harness_version": "2.0.2",
  "project": "",
  "root_branch": "main",
  "layout": "multi-repo",
  "services_dir": "source-code",
  "services": [],
  "protected_branches": [
    "main",
    "master",
    "develop",
    "production",
    "staging",
    "release/*"
  ],
  "git": {
    "host": "github.com",
    "default_account": null,
    "services": {}
  },
  "remap": {
    "legacy_months": 2
  },
  "tui": {
    "statusline": true,
    "theme": "kapsul",
    "max_width": 120
  },
  "update": {
    "autoPush": false
  },
  "antislop": {
    "mode": "during"
  }
}
