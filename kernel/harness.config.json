{
  "harness_version": "1.5.1",
  "project": "",
  "root_branch": "main",
  "layout": "multi-repo",
  "services_dir": "source-code",
  "services": [],
  "protected_branches": [
    "main",
    "master",
    "develop",
    "production",
    "staging",
    "release/*"
  ],
  "schema_paths": [
    "**/migrations/**",
    "**/migration/**",
    "**/*.sql",
    "**/schema.prisma"
  ],
  "gate": {
    "test_command": null,
    "test_required": false,
    "test_timeout_sec": 300,
    "require_checks": false
  },
  "context": {
    "window_tokens": 1000000,
    "warn_tokens": 400000
  },
  "knowledge": {
    "summary_max_lines": 80,
    "patterns_max_lines": 150,
    "stale_warn_commits": 15
  },
  "baseline": {},
  "quick": {
    "max_files": 5
  },
  "amend": {
    "max": 3
  },
  "checks": {},
  "ship": {
    "base": {},
    "merge_method": "merge",
    "ticket_ttl_min": 30
  }
}
